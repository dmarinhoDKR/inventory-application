<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title><%= title %> | <%= appName %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="page-shell">
        <header>
            <p class="eyebrow">Category form</p>
            <h1><%= title %></h1>
            <p class="lead">
                Enter a unique name and a useful description.
            </p>
        </header>

        <% if (errors.length > 0) { %>
            <section
                class="form-errors"
                aria-labelledby="form-errors-heading"
            >
                <h2 id="form-errors-heading">
                    Please correct the following:
                </h2>

                <ul>
                    <% errors.forEach((error) => { %>
                        <li><%= error %></li>
                    <% }); %>
                </ul>
            </section>
        <% } %>

        <form
            class="inventory-form"
            method="POST"
            action="<%= formAction %>"
        >
            <div class="form-field">
                <label for="name">Name</label>
                <input
                    id="name"
                    name="name"
                    type="text"
                    maxlength="100"
                    value="<%= category.name %>"
                    required
                >
            </div>

            <div class="form-field">
                <label for="description">
                    Description
                </label>
                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    required
                ><%= category.description %></textarea>
            </div>

            <div class="form-actions">
                <button
                    class="button-link"
                    type="submit"
                >
                    <%= submitLabel %>
                </button>

                <a href="/categories">Cancel</a>
            </div>
        </form>
    </main>
</body>
</html>
