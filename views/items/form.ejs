<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title><%= title %> | <%= appName %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="page-shell">
        <header>
            <p class="eyebrow">Item form</p>
            <h1><%= title %></h1>
            <p class="lead">
                Record the part details, price, stock quantity,
                and category.
            </p>
        </header>

        <% if (errors.length > 0) { %>
            <section
                class="form-errors"
                aria-labelledby="form-errors-heading"
            >
                <h2 id="form-errors-heading">
                    Please correct the following:
                </h2>

                <ul>
                    <% errors.forEach((error) => { %>
                        <li><%= error %></li>
                    <% }); %>
                </ul>
            </section>
        <% } %>

        <form
            class="inventory-form"
            method="POST"
            action="<%= formAction %>"
        >
            <div class="form-field">
                <label for="name">Name</label>
                <input
                    id="name"
                    name="name"
                    type="text"
                    maxlength="150"
                    value="<%= item.name %>"
                    required
                >
            </div>

            <div class="form-field">
                <label for="description">
                    Description
                </label>
                <textarea
                    id="description"
                    name="description"
                    rows="5"
                    required
                ><%= item.description %></textarea>
            </div>

            <div class="form-field">
                <label for="manufacturer">
                    Manufacturer
                </label>
                <input
                    id="manufacturer"
                    name="manufacturer"
                    type="text"
                    maxlength="100"
                    value="<%= item.manufacturer %>"
                    required
                >
            </div>

            <div class="form-field">
                <label for="sku">SKU</label>
                <input
                    id="sku"
                    name="sku"
                    type="text"
                    maxlength="50"
                    value="<%= item.sku %>"
                    required
                >
            </div>

            <div class="form-field">
                <label for="price">Price</label>
                <input
                    id="price"
                    name="price"
                    type="number"
                    min="0"
                    max="99999999.99"
                    step="0.01"
                    value="<%= item.price %>"
                    required
                >
            </div>

            <div class="form-field">
                <label for="quantity">
                    Quantity
                </label>
                <input
                    id="quantity"
                    name="quantity"
                    type="number"
                    min="0"
                    step="1"
                    value="<%= item.quantity %>"
                    required
                >
            </div>

            <div class="form-field">
                <label for="categoryId">
                    Category
                </label>
                <select
                    id="categoryId"
                    name="categoryId"
                    required
                >
                    <option value="">
                        Select a category
                    </option>

                    <% categories.forEach((category) => { %>
                        <option
                            value="<%= category.id %>"
                            <%= (
                                String(category.id) ===
                                item.categoryId
                            ) ? "selected" : "" %>
                        >
                            <%= category.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="form-actions">
                <button
                    class="button-link"
                    type="submit"
                >
                    <%= submitLabel %>
                </button>

                <a href="/items">Cancel</a>
            </div>
        </form>
    </main>
</body>
</html>
